bspc subscribe node_state | while read -r _ _ _ _ state flag; do
    if [ "$state" = "fullscreen" ]; then
        if [ "$flag" = "on" ]; then
            polybar-msg cmd hide 2>/dev/null
        else
            polybar-msg cmd show 2>/dev/null
        fi
    fi
done &
